rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/todos/{todoId} {
      function owner() { return request.auth != null && request.auth.uid == userId; }
      function validTodo() {
        return request.resource.data.keys().hasAll(['description', 'isComplete'])
          && request.resource.data.keys().hasOnly(['description', 'isComplete'])
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.description.size() <= 500
          && request.resource.data.description.matches('.*[^\\s].*')
          && request.resource.data.isComplete is bool;
      }
      allow read, delete: if owner();
      allow create, update: if owner() && validTodo();
    }
  }
}
